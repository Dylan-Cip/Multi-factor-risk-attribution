      "cell_type": "code",
      "source": "# ==============================================================================\n# PROJECT 1: FAMA-FRENCH MULTI-FACTOR EQUITY RISK ATTRIBUTION (JupyterLite Edition)\n# Target Field: Quantitative Finance & Applied Econometrics\n# ==============================================================================\n\nimport pandas as pd\nimport numpy as np\nimport statsmodels.api as sm\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# Set visual style for institutional-style plots\nplt.style.use('seaborn-v0_8-whitegrid')\nplt.rcParams['font.family'] = 'sans-serif'\n\nprint(\"--- STEP 1: GENERATING MONTE CARLO ASSET & FACTOR DATA ---\")\n\n# Ensure full reproducibility\nnp.random.seed(42)\nn_days = 1260 # 5 years of daily trading data\ndates = pd.date_range(start='2020-01-01', periods=n_days, freq='B')\n\ntickers = ['AAPL', 'MSFT', 'JNJ', 'JPM', 'AMZN']\nfactor_names = ['SPY_Market', 'IWM_SmallCap', 'IWD_Value', 'IWF_Growth']\n\n# Simulate correlated daily log returns using a covariance structure\ncov_matrix = np.eye(len(tickers) + len(factor_names)) * 0.0002\ncov_matrix += 0.0001 # Add non-zero covariance between assets\n\nall_series = tickers + factor_names\nsimulated_returns = np.random.multivariate_normal(\n    mean=np.full(len(all_series), 0.0004), # ~10% annual baseline drift\n    cov=cov_matrix, \n    size=n_days\n)\n\nreturns_df = pd.DataFrame(simulated_returns, index=dates, columns=all_series)\n\n# Separate assets and factor proxies\nreturns = returns_df[tickers]\nfactor_returns = returns_df[factor_names]\n\nprint(f\"Successfully constructed dataset across {len(returns)} trading sessions.\")\n\n# Step 2: Construct Factor Series\nprint(\"\\n--- STEP 2: CONSTRUCTING RISK FACTORS ---\")\n\nrf_daily = 0.04 / 252 # ~4% annualized risk-free baseline rate\n\n# 1. MKT-RF: Excess Market Return over Risk-Free proxy\nmkt_rf = factor_returns['SPY_Market'] - rf_daily\n\n# 2. SMB (Small Minus Big): Small Cap minus Broad Market\nsmb = factor_returns['IWM_SmallCap'] - factor_returns['SPY_Market']\n\n# 3. HML (High Minus Low): Value ETF minus Growth ETF\nhml = factor_returns['IWD_Value'] - factor_returns['IWF_Growth']\n\nfactors = pd.DataFrame({\n    'Market_Excess': mkt_rf,\n    'SMB_Size': smb,\n    'HML_Value': hml\n})\n\n# Step 3: Run Multivariate Ordinary Least Squares (OLS) Regressions\nprint(\"\\n--- STEP 3: RUNNING MULTIVARIATE REGRESSIONS ---\")\n\nresults_list = []\n\nfor ticker in tickers:\n    asset_excess = returns[ticker] - rf_daily\n    \n    # Add constant term for Jensen's Alpha (\\alpha)\n    X = sm.add_constant(factors)\n    y = asset_excess\n    \n    # Fit linear model\n    model = sm.OLS(y, X).fit()\n    \n    # Extract statistics\n    alpha_annualized = model.params['const'] * 252\n    beta_mkt = model.params['Market_Excess']\n    beta_smb = model.params['SMB_Size']\n    beta_hml = model.params['HML_Value']\n    r_squared = model.rsquared\n    \n    results_list.append({\n        'Ticker': ticker,\n        'Annualized Alpha (%)': alpha_annualized * 100,\n        'Market Beta (\\beta_MKT)': beta_mkt,\n        'Size Beta (\\beta_SMB)': beta_smb,\n        'Value Beta (\\beta_HML)': beta_hml,\n        'R-Squared (Explanability)': r_squared\n    })\n\nsummary_df = pd.DataFrame(results_list).set_index('Ticker')\nprint(summary_df.round(4))\n\n# Step 4: Visualizations\nprint(\"\\n--- STEP 4: GENERATING ATTRIBUTION DASHBOARD ---\")\n\nfig, axes = plt.subplots(1, 2, figsize=(15, 5))\n\n# Plot 1: Risk Factor Exposure Heatmap\nsns.heatmap(\n    summary_df[['Market Beta (\\beta_MKT)', 'Size Beta (\\beta_SMB)', 'Value Beta (\\beta_HML)']], \n    annot=True, \n    cmap='coolwarm', \n    center=0, \n    fmt=\".3f\", \n    ax=axes[0], \n    cbar_kws={'label': 'Factor Sensitivity (Beta)'}\n)\naxes[0].set_title('Asset Risk Factor Exposure Matrix', fontsize=12, fontweight='bold')\n\n# Plot 2: Alpha Decomposition & Model R-Squared\naxes[1].bar(summary_df.index, summary_df['Annualized Alpha (%)'], color='#1f77b4', alpha=0.7, label='Alpha (%)')\naxes[1].set_ylabel('Annualized Alpha (%)', color='#1f77b4')\naxes[1].set_title('Risk-Adjusted Alpha & Explanatory Power ($R^2$)', fontsize=12, fontweight='bold')\n\nax2 = axes[1].twinx()\nax2.plot(summary_df.index, summary_df['R-Squared (Explanability)'], color='#d62728', marker='o', linewidth=2)\nax2.set_ylabel('Model R-Squared', color='#d62728')\nax2.set_ylim(0, 1)\n\nplt.tight_layout()\nplt.show()",
